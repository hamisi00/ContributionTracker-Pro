# Firebase Configuration (Optional - for environment-based config)
# Get these from: https://console.firebase.google.com/
# Project Settings > General > Your apps > Firebase SDK snippet > Config

# NOTE: These environment variables are OPTIONAL
# Firebase config is already included in firebase-config.js for convenience
# Use these environment variables if you want to override the default config
# or deploy to different environments (dev/staging/prod)

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Development settings
VITE_USE_FIREBASE_EMULATOR=false
VITE_ENABLE_PERSISTENCE=true
